<Window x:Class="Field.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Field" Style="{StaticResource AppWindow}" Title="FIELD / 01 — Dictation recorder" Width="{StaticResource WindowWidth}" Height="{StaticResource WindowHeight}" MinWidth="{StaticResource WindowMinWidth}" MinHeight="{StaticResource WindowMinHeight}" Closing="OnClosing">
 <DockPanel><Menu DockPanel.Dock="Top" Background="{StaticResource Panel}"><MenuItem Header="_File"><MenuItem Header="_Settings…" InputGestureText="Ctrl+," Click="OpenSettings"/><Separator/><MenuItem Header="E_xit" Click="ExitApp"/></MenuItem><MenuItem Header="_Recording"><MenuItem Header="_Start / Stop" Click="ToggleRecording"/><MenuItem Header="_Cancel" InputGestureText="Esc" Click="CancelRecording"/></MenuItem><MenuItem Header="_Dictionary"><MenuItem Header="Open dictionary _file" Click="OpenDictionaryFile"/></MenuItem></Menu>
 <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="{StaticResource Space2}"><TextBlock x:Name="Status" Text="READY — Configure whisper.cpp and a model in Settings."/></StatusBar>
 <Grid Margin="{StaticResource Space6}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel><TextBlock Text="FIELD / 01" Style="{StaticResource Heading}"/><TextBlock Text="PERSONAL DICTATION RECORDER" Style="{StaticResource Label}" HorizontalAlignment="Right"/></DockPanel>
 <Border Grid.Row="1" Style="{StaticResource PanelFrame}" Margin="{StaticResource Space2}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:VuMeter x:Name="Meter" Height="{StaticResource MeterHeight}"/><StackPanel Grid.Column="1" Margin="{StaticResource Space4}"><TextBlock Text="TRANSPORT / MICROPHONE" Style="{StaticResource Label}"/><TextBlock x:Name="ShortcutHint" Style="{StaticResource Label}"/><TextBlock x:Name="Counter" Text="00:00.0" FontFamily="{StaticResource MeterFont}" FontSize="{StaticResource CounterSize}" Margin="{StaticResource Space2}"/><StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="●  RECORD" Background="{StaticResource Record}" MinHeight="{StaticResource TransportHeight}" Click="StartRecording"/><Button x:Name="StopButton" Content="■  STOP" MinHeight="{StaticResource TransportHeight}" IsEnabled="False" Click="StopRecording"/><Button Content="SETTINGS" Click="OpenSettings"/></StackPanel></StackPanel></Grid></Border>
 <TabControl Grid.Row="2" Margin="{StaticResource Space2}"><TabItem Header="TRANSCRIPTIONS"><DockPanel Margin="{StaticResource Space3}"><TextBox x:Name="HistorySearch" DockPanel.Dock="Top" ToolTip="Search transcriptions" AutomationProperties.Name="Search transcriptions" TextChanged="SearchHistory"/><TextBlock x:Name="HistoryEmpty" DockPanel.Dock="Top" Text="No recordings yet. Press RECORD, or hold your configured hotkey in another app." Margin="{StaticResource Space3}"/><ListBox x:Name="HistoryList"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Seam}" BorderThickness="{StaticResource BottomSeam}" Padding="{StaticResource Space3}"><StackPanel><DockPanel><Button Content="COPY" DockPanel.Dock="Right" Click="CopyTranscript" Tag="{Binding}"/><TextBlock Text="{Binding Stamp}" Style="{StaticResource Label}"/></DockPanel><TextBlock Text="{Binding Text}" Margin="{StaticResource Space2}"/><TextBlock Text="{Binding CorrectionSummary}" Foreground="{StaticResource Amber}" FontSize="{StaticResource CaptionSize}" Margin="{StaticResource Space2}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
 <TabItem Header="DICTIONARY"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="{StaticResource Space3}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="DictionarySearch" ToolTip="Search dictionary" AutomationProperties.Name="Search dictionary" TextChanged="SearchDictionary"/><ListBox Grid.Row="1" x:Name="DictionaryList" MinHeight="{StaticResource EditorHeight}" MaxHeight="{StaticResource MeterHeight}" SelectionChanged="SelectEntry" DisplayMemberPath="Display"/>
 <StackPanel Grid.Row="2"><TextBlock Text="WORD / PHRASE — OR CORRECTION PAIR" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WRITE THIS / WORD TO KNOW" Style="{StaticResource Label}"/><TextBox x:Name="TargetWord" TextChanged="EntryChanged" AutomationProperties.Name="Word or correct phrase"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="WHEN YOU HEAR (OPTIONAL)" Style="{StaticResource Label}"/><TextBox x:Name="HeardWord" TextChanged="EntryChanged" AutomationProperties.Name="Phrase to correct"/></StackPanel></Grid><TextBlock x:Name="DictionaryWarning" Foreground="{StaticResource Amber}" Margin="{StaticResource Space2}"/><StackPanel Orientation="Horizontal"><Button Content="SAVE ENTRY" Click="SaveEntry"/><Button Content="NEW" Click="NewEntry"/><Button Content="DELETE" Click="DeleteEntry"/><Button Content="OPEN PLAIN FILE" Click="OpenDictionaryFile"/></StackPanel></StackPanel>
 </Grid></ScrollViewer></TabItem></TabControl>
 </Grid></DockPanel>
</Window>
