<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Padding" Value="{StaticResource Space3}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Seam}" BorderThickness="{StaticResource BorderWidth}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}" Margin="{StaticResource Space1}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource Control}"/><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Highlight}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/><Setter Property="Margin" Value="{StaticResource Space1}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource Input}" BorderBrush="{StaticResource Seam}" BorderThickness="{StaticResource BorderWidth}" CornerRadius="{StaticResource ControlRadius}"/></ControlTemplate></ToggleButton.Template></ToggleButton><DockPanel IsHitTestVisible="False" Margin="{StaticResource Space2}"><TextBlock DockPanel.Dock="Right" Text="⌄"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/></DockPanel><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="{StaticResource Input}" BorderBrush="{StaticResource Seam}" BorderThickness="{StaticResource BorderWidth}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="{StaticResource Space2}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Face" Background="{StaticResource Input}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource Control}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#181A1E"/><SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6E8ED"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#363A42"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E6E8ED"/>
<Style TargetType="MenuItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Panel}"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource Control}"/></Trigger></Style.Triggers></Style></ResourceDictionary>
